{
  "name": "go-to-mars",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "release": "npm run export:data && npm run build && node scripts/package-orbital.mjs",
    "test:3d": "tsx --test tests/orbital.test.ts",
    "export:data": "tsx scripts/export-engines.ts",
    "trailer:capture": "node tools/trailer/capture.mjs",
    "trailer:finish": "python3 tools/trailer/finish.py",
    "trailer:verify": "node tools/trailer/verify.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "three": "^0.186.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fendouai/GoToMars.git"
  }
}
